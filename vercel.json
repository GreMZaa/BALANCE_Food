{
  "version": 2,
  "builds": [
    {
      "src": "src/bot.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/bot.js"
    },
    {
      "src": "/courier",
      "dest": "src/bot.js"
    },
    {
      "src": "/admin",
      "dest": "src/bot.js"
    },
    {
      "src": "/owner",
      "dest": "src/bot.js"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
